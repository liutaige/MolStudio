#!/usr/bin/env python3
"""Keep unpublished local applications out of GitHub's canvas branch."""
import subprocess
import sys

ALLOWED = {'.gitignore', '.githooks', 'AGENTS.md', 'README.md', 'fusion',
           'fusion-native', 'integrations', 'ketcher-local', 'scripts', 'skills'}

for line in sys.stdin:
    local_ref, local_oid, remote_ref, _ = line.split()
    if remote_ref != 'refs/heads/main' or set(local_oid) == {'0'}:
        sys.exit('只允许推送画布 main；本地完整分支和标签不上传。')
    new_commits = subprocess.check_output(
        ['git', 'rev-list', local_oid, '--not', '--remotes=origin']
    ).decode().splitlines()
    for commit in dict.fromkeys([local_oid, *new_commits]):
        paths = subprocess.check_output(
            ['git', 'ls-tree', '-r', '--name-only', '-z', commit]
        ).decode().split('\0')
        blocked = [p for p in paths if p and p.split('/', 1)[0] not in ALLOWED]
        if blocked:
            sys.exit('推送提交包含画布范围以外的文件：\n' + '\n'.join(blocked[:12]))
